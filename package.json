{
  "name": "saucedemo-playwright-e2e",
  "version": "1.0.0",
  "description": "End-to-End Test Automation Framework for SauceDemo using Playwright and TypeScript with Page Object Model (POM)",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report"
  },
  "keywords": [
    "qa",
    "playwright",
    "typescript",
    "e2e-testing",
    "page-object-model",
    "test-automation",
    "saucedemo"
  ],
  "author": "Vitor Hugo <Arashinho1>",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0"
  }
}
